# Copiá este archivo a "keystore.properties" (en la raíz del repo, junto a settings.gradle.kts)
# y completá los valores reales. "keystore.properties" está en .gitignore: nunca se sube al repo.
#
# 1) Generar el keystore (una sola vez, guardalo en un lugar seguro con backup):
#    keytool -genkeypair -v -keystore finanzasbrutal-release.jks -alias finanzasbrutal \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2) Completar acá las rutas/contraseñas que elegiste en el paso anterior.

storeFile=/ruta/absoluta/a/finanzasbrutal-release.jks
storePassword=CAMBIAR_ESTA_CONTRASENA
keyAlias=finanzasbrutal
keyPassword=CAMBIAR_ESTA_CONTRASENA
