# Copiá este archivo a .env.local y completá los valores.
# .env.local nunca se sube al repositorio (ver .gitignore).

# Supabase (Project Settings > API en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (console.anthropic.com > API Keys) — solo se usa en el servidor,
# nunca se expone al navegador.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar para generar los quiz. Por defecto usa un modelo
# económico (Haiku) que alcanza de sobra para este caso.
# ANTHROPIC_QUIZ_MODEL=claude-haiku-4-5-20251001
